// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  GITHUB
  CREDENTIALS
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model User {
  id           String       @id @default(uuid())
  username     String?      @unique @db.VarChar(50)
  email        String       @unique @db.VarChar(320)
  password     String?
  authProvider AuthProvider @default(CREDENTIALS)
  providerId   String?
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id       String  @id @default(uuid())
  name     String  @default("Untitled Project") @db.VarChar(150)
  isActive Boolean @default(true)
  userId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  workflows     Workflow[]
  conversations Conversation[]
  executions    WorkflowExecution[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model Workflow {
  id        String   @id @default(uuid())
  note      String?  @db.VarChar(255)
  version   String   @db.VarChar(20)
  isLive    Boolean  @default(false) @map("is_live")
  graph     Json
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project             @relation(fields: [projectId], references: [id])
  executions    WorkflowExecution[]
  conversations Conversation[]

  @@unique([projectId, version])
  @@index([projectId, isLive])
  @@index([projectId, createdAt])
  @@map("workflows")
}

model WorkflowExecution {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  projectId   String   @map("project_id")
  status      String   @default("COMPLETED") @db.VarChar(50)
  inputs      Json
  outputs     Json?
  state       Json?
  trace       Json?
  durationMs  Int?     @map("duration_ms")
  totalTokens Int?     @map("total_tokens")

  createdAt   DateTime @default(now()) @map("created_at")

  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([projectId, createdAt])
  @@map("workflow_executions")
}

model Conversation {
  id              String    @id @default(uuid())
  name            String    @default("Untitled Conversation") @db.VarChar(150)
  projectId       String
  workflowId      String?   @map("workflow_id")
  workflowVersion String?   @map("workflow_version") @db.VarChar(50)
  isLive          Boolean   @default(false) @map("is_live")
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id])
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([projectId, updatedAt])
  @@index([workflowId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        Json
  metadata       Json
  model          String?     @db.VarChar(100)
  inputTokens    Int?
  outputTokens   Int?
  cost           Float?
  currency       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}
